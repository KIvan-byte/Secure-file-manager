{
  "name": "secure-file-manager",
  "version": "1.0.0",
  "description": "Secure file manager with one-time share links and access auditing",
  "main": "main.js",
  "homepage": "./",
  "private": true,
  "scripts": {
    "dev": "concurrently \"react-app-rewired start\" \"wait-on http://localhost:3000 && electron .\"",
    "start": "npm run build && cross-env NODE_ENV=production electron .",
    "start:prod": "cross-env NODE_ENV=production electron .",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test",
    "eject": "react-scripts eject"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "archiver": "^5.3.1",
    "cors": "^2.8.5",
    "electron": "^24.0.0",
    "electron-is-dev": "^2.0.0",
    "express": "^4.18.2",
    "extract-zip": "^2.0.1",
    "ip": "^1.1.9",
    "lowdb": "^5.1.0",
    "path-browserify": "^1.0.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.10.1",
    "react-router-dom": "^6.14.2",
    "recharts": "^2.7.2",
    "speakeasy": "^2.0.0",
    "styled-components": "^6.0.7",
    "tar": "^6.1.15",
    "uuid": "^9.0.0",
    "wait-on": "^7.2.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^25.3.1",
    "electron-builder": "^24.6.3",
    "react-app-rewired": "^2.2.1",
    "react-scripts": "5.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
