{
  "name": "secure-file-manager",
  "version": "1.0.0",
  "description": "Secure file manager with one-time share links and access auditing",
  "main": "main.js",
  "homepage": "./",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite --port 5174\" \"wait-on http://localhost:5174 && electron .\"",
    "start": "npm run build && cross-env NODE_ENV=production electron .",
    "start:prod": "cross-env NODE_ENV=production electron .",
    "build": "vite build",
    "preview": "vite preview"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "electron": "^28.2.0",
    "electron-is-dev": "^2.0.0",
    "express": "^4.18.2",
    "extract-zip": "^2.0.1",
    "lowdb": "^7.0.1",
    "path-browserify": "^1.0.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.21.3",
    "recharts": "^2.12.0",
    "speakeasy": "^2.0.0",
    "styled-components": "^6.1.8",
    "tar": "^6.2.0",
    "uuid": "^9.0.1",
    "wait-on": "^7.2.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.9.1",
    "vite": "^7.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
